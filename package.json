{
  "name": "kpal_client",
  "version": "1.3.3",
  "description": "Krunker Desktop Client",
  "main": "js/main.js",
  "author": "KPal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kpal81xd/krunker-kpal-client.git"
  },
  "scripts": {
    "start": "cmd /c \"./dist/win-unpacked/KPal Client.exe\"",
    "dev": "electron --no-sandbox . --dev",
    "snap": "node scripts/run-snapshot.js",
    "kill": "node scripts/kill-node.js",
    "clean": "node scripts/clean.js",
    "dist": "electron-builder",
    "dist-ml": "electron-builder -ml",
    "ship": "electron-builder -p always",
    "ship-ml": "electron-builder -ml -p always"
  },
  "build": {
    "appId": "com.kpal.krunker_client",
    "productName": "KPal Client",
    "files": [
      "**/*",
      "!scripts/*",
      "!cache/*",
      "!js/load.js"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "category": "Game",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "discord-rpc": "^3.1.0",
    "electron-localshortcut": "^3.1.0",
    "electron-log": "^3.0.8",
    "electron-store": "^3.3.0",
    "electron-updater": "^6.1.4",
    "v8-compile-cache": "^2.1.0"
  },
  "devDependencies": {
    "bufferutil": "^4.0.8",
    "electron": "7.0.0",
    "electron-builder": "^24.6.4",
    "electron-link": "^0.6.0",
    "electron-mksnapshot": "7.0.0",
    "encoding": "^0.1.13",
    "find-process": "^1.4.7",
    "javascript-obfuscator": "^0.27.2",
    "rimraf": "^5.0.5",
    "terser": "^4.3.9",
    "utf-8-validate": "^5.0.10"
  }
}
