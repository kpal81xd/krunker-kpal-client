{
    "name": "kpal_client",
    "version": "1.3.3",
    "private": true,
    "description": "Krunker Desktop Client",
    "repository": {
        "type": "git",
        "url": "https://github.com/kpal81xd/krunker-kpal-client.git"
    },
    "license": "MIT",
    "author": "KPal",
    "type": "commonjs",
    "main": "out/main.js",
    "scripts": {
        "build": "bun scripts/build.mts",
        "dev": "bun scripts/build.mts --dev && electron --no-sandbox . --dev",
        "dist": "bun run build && electron-builder",
        "lint": "prettier --check . && eslint . && tsc --project ./tsconfig.src.json && tsc --project ./tsconfig.dev.json",
        "lint-fix": "prettier --write . && eslint --fix ."
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/bun": "1.4.2",
        "@types/discord-rpc": "4.0.11",
        "@types/electron-localshortcut": "3.1.3",
        "discord-rpc": "3.2.0",
        "electron": "7.0.0",
        "electron-builder": "26.15.3",
        "electron-localshortcut": "3.2.1",
        "electron-log": "4.4.8",
        "electron-store": "8.2.0",
        "electron-updater": "6.8.9",
        "esbuild": "0.28.2",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-package-json": "1.10.1",
        "eslint-plugin-prettier": "5.5.6",
        "jsonc-eslint-parser": "3.3.0",
        "prettier": "3.9.9",
        "rcedit": "5.0.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0"
    },
    "packageManager": "bun@1.3.14",
    "build": {
        "appId": "com.kpal.krunker_client",
        "productName": "KPal Client",
        "disableAsarIntegrity": true,
        "files": [
            "out/**/*",
            "package.json"
        ],
        "directories": {
            "buildResources": "build",
            "output": "dist"
        },
        "afterPack": "scripts/after-pack.mjs",
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ],
            "signAndEditExecutable": false
        },
        "nsis": {
            "artifactName": "KPal-Client-Setup-${version}.${ext}"
        },
        "mac": {
            "artifactName": "KPal-Client-${version}-mac.${ext}"
        },
        "linux": {
            "category": "Game",
            "icon": "build/icon.png",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ],
            "artifactName": "KPal-Client-${version}-${arch}.${ext}"
        }
    },
    "trustedDependencies": [
        "electron",
        "esbuild",
        "unrs-resolver"
    ]
}
